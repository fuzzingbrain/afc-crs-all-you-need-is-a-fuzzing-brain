# Secrets and infrastructure only. Everything about a run (budget, timeouts,
# models, features) goes in the JSON task file.

# LLM API Keys (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=


# PostgreSQL and Redis (defaults shown; change only if yours run elsewhere).
# A local PostgreSQL that is not running is started in a container, with the
# user, password and database name taken from this URL.
POSTGRES_URL=postgresql+psycopg://fuzzingbrain:fuzzingbrain@localhost:5432/fuzzingbrain
REDIS_URL=redis://localhost:6379/0


# OpenRouter: one key for most hosted models, open-weight ones included
# This endpoint is in progress.
OPENROUTER_API_KEY=