#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# The shell omp's `bash` tool runs through (wired in as `shellPath`).
#
# Two things happen here that a plain /bin/bash would not do.
#
# 1. The Docker socket is masked, always. The challenge image carries both the
#    instrumented harness and `oracle.yaml` -- the answer -- under a root-owned
#    0700 directory. An agent that can reach the Docker daemon can start that
#    image as root and read the answer straight out, which would make its score
#    mean nothing. The agent does not need Docker: `./try_poc` hands a candidate
#    to a judge process running outside this namespace.
#
# 2. With FBAGENT_NO_NETWORK=1, the shell also gets an empty network namespace.
#    The fault the agent is asked to find is in the source in front of it, so
#    nothing legitimate is lost; what goes away is fetching a published PoC for
#    the bug. Loopback is brought back up because a build or test may bind to
#    it, and an interface that is merely DOWN reads as a broken toolchain rather
#    than a deliberate restriction.
#
# Both are enforced by the kernel rather than by asking the model nicely, which
# is the only form of this that survives a model that decides to try.

set -u

inner='
  mount --bind /dev/null /var/run/docker.sock 2>/dev/null || true
  if [ "${FBAGENT_NO_NETWORK:-0}" = "1" ]; then
    ip link set lo up 2>/dev/null || true
  fi
  exec /bin/bash "$@"
'

if [ "${FBAGENT_NO_NETWORK:-0}" = "1" ]; then
  exec unshare --mount --net --user --map-root-user \
    /bin/bash -c "$inner" -- "$@"
fi

exec unshare --mount --user --map-root-user \
  /bin/bash -c "$inner" -- "$@"
